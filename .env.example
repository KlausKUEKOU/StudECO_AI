# Copiez ce fichier en .env et remplissez la clé du fournisseur choisi.

# Fournisseur par défaut : groq | ollama | openrouter | dashscope | custom
STUDECO_PROVIDER=groq
# Modèle par défaut (facultatif ; sinon celui du préréglage)
# STUDECO_MODEL=qwen/qwen3.8-27b

# Groq - gratuit avec limites de débit : https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Alibaba Model Studio (Qwen officiel) : https://modelstudio.console.alibabacloud.com
DASHSCOPE_API_KEY=

# Serveur compatible OpenAI personnalisé (vLLM, LM Studio…)
# STUDECO_BASE_URL=http://localhost:8000/v1
# STUDECO_API_KEY=
